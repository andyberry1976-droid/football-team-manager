<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Squads</p>
    <h1>Teams</h1>
  </div>
  <a class="btn" href="/teams/new">Add a team</a>
</div>

<% if (!teams.length) { %>
  <section class="panel">
    <p class="muted">No teams yet. Add a team to get started.</p>
  </section>
<% } else { %>
  <ul class="card-list">
    <% teams.forEach(function (team) { %>
      <li class="card">
        <a href="/teams/<%= team.id %>">
          <span class="card-title">
            <%- include('../partials/swatch', { colour: team.colour }) %>
            <%= team.name %>
            <% if (team.short_name) { %><span class="tag"><%= team.short_name %></span><% } %>
          </span>
          <span class="muted"><%= team.player_count %> player<%= team.player_count === 1 ? '' : 's' %></span>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('../partials/foot') %>
