<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <p class="eyebrow">Scores</p>
    <h1>Results</h1>
  </div>
  <a class="btn btn-secondary" href="/fixtures">Upcoming fixtures</a>
</div>

<% if (!results.length) { %>
  <section class="panel">
    <p class="muted">No results yet. Enter a score for a fixture to add it here.</p>
  </section>
<% } else { %>
  <section class="panel">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Date and time</th>
            <th scope="col">Match</th>
            <th scope="col">Venue</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% results.forEach(function (fixture) { %>
            <tr>
              <td><a href="/fixtures/<%= fixture.id %>"><%= formatKickoff(fixture.kickoff) %></a></td>
              <td>
                <%- include('../partials/swatch', { colour: fixture.home_colour }) %>
                <%= fixture.home_team_name %>
                <strong class="score-inline"><%= fixture.home_goals %>–<%= fixture.away_goals %></strong>
                <%- include('../partials/swatch', { colour: fixture.away_colour }) %>
                <%= fixture.away_team_name %>
              </td>
              <td><%= fixture.venue || '—' %></td>
              <td class="row-actions">
                <a href="/fixtures/<%= fixture.id %>/result">Edit result</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
<%- include('../partials/foot') %>
